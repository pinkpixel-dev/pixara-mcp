# Required — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional — where generated images are saved (default: ./generated-images)
OPENROUTER_IMAGE_OUTPUT_DIR=./generated-images

# Optional — sent as HTTP-Referer / X-Title headers so OpenRouter can attribute
# and rank your app on openrouter.ai/rankings
OPENROUTER_SITE_URL=https://your-app-url.example
OPENROUTER_SITE_NAME=Your App Name
