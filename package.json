{
  "name": "@pinkpixel/pixara-mcp",
  "version": "1.0.0",
  "description": "MCP server that lets LLMs generate and edit images through OpenRouter's Image API",
  "author": "Pink Pixel",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pinkpixel/pixara-mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pixara-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openrouter",
    "image-generation",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
